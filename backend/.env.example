# Database Connection (SQLite default, or MilesWeb PostgreSQL / MySQL)
DATABASE_URL=sqlite:///./cmms.db
# MilesWeb PostgreSQL: DATABASE_URL=postgresql://db_user:db_password@localhost:5432/sumant_cmms
# MilesWeb MySQL/MariaDB: DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/sumant_cmms

# Connection Pool Tuning (PostgreSQL / MySQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

CMMS_SECRET=your-strong-random-secret-here
CORS_ORIGINS=http://localhost:5173
CMMS_UPLOADS=./uploads
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=cmms@yourcompany.com
MAIL_SERVER=smtp.yourcompany.com
MAIL_PORT=587
